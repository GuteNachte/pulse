{
  "schemaVersion": 1,
  "forbiddenTrackedPaths": [
    {
      "id": "runtime-data",
      "description": "Pulse runtime data must never be tracked.",
      "pattern": "(?i)(?:^|/)pulse_data[^/]*(?:/|$)"
    },
    {
      "id": "pocketbase-database",
      "description": "PocketBase and SQLite database files must never be tracked.",
      "pattern": "(?i)(?:^|/)[^/]+\\.(?:db|sqlite|sqlite3)$"
    },
    {
      "id": "backup-artifact",
      "description": "Local backup directories and backup archives must never be tracked.",
      "pattern": "(?i)(?:^|/)backups?(?:/|$)|(?:^|/)[^/]*backup[^/]*\\.(?:bak|backup|zip|7z|tgz|tar\\.gz)$"
    },
    {
      "id": "runtime-log",
      "description": "Runtime logs must never be tracked.",
      "pattern": "(?i)(?:^|/)(?:logs?/|[^/]+\\.log$)"
    },
    {
      "id": "generated-credential-file",
      "description": "Generated credentials and local environment files must never be tracked.",
      "pattern": "(?i)(?:^|/)(?:credentials?|secrets?)(?:/|$)|(?:^|/)(?:credentials?|secrets?)(?:[._-][^/]*)?\\.(?:json|ya?ml|toml|ini|txt)$|(?:^|/)\\.env(?:\\.[^/]+)?$"
    },
    {
      "id": "private-key-file",
      "description": "Private keys and certificate bundles must never be tracked.",
      "pattern": "(?i)(?:^|/)(?:id_(?:rsa|ed25519)|[^/]+\\.(?:pem|key|p12|pfx))$"
    },
    {
      "id": "local-media",
      "description": "Private device photos and uploaded local media must never be tracked.",
      "pattern": "(?i)(?:^|/)(?:device-photos|local-media|private-media|uploads?)(?:/|$)"
    }
  ],
  "forbiddenContent": [
    {
      "id": "credential-assignment",
      "description": "Credential-shaped assignments must use an explicit redacted placeholder.",
      "pathPattern": "(?i)\\.(?:env|ini|json|ya?ml|toml|ps1|sh|cmd|md|txt)$",
      "pattern": "(?im)^\\s*(?:token|password|secret|api[_-]?key|access[_-]?key)\\s*[:=]\\s*[\"']?(?!(?:example-redacted|redacted|changeme|replace-me|<[^>\\r\\n]+>|\\$\\{[^}\\r\\n]+\\}|\\$env:[a-z0-9_]+|\\$[a-z_][a-z0-9_.]*|%[a-z0-9_]+%|your_[a-z0-9_]+)[\"']?\\s*$)[^\\s\"'#]{8,}"
    },
    {
      "id": "private-legacy-endpoint",
      "description": "The legacy private API endpoint must not appear in public-facing files.",
      "pathPattern": "(?s).*",
      "pattern": "192\\.168\\.1\\.20:3005",
      "historyLiteralParts": ["192.168.1.", "20:3005"]
    },
    {
      "id": "private-harbor-endpoint",
      "description": "The private Harbor endpoint must not appear in public-facing files.",
      "pathPattern": "(?s).*",
      "pattern": "hb\\.gutenacht\\.site:66",
      "historyLiteralParts": ["hb.gutenacht.site", ":66"]
    }
  ],
  "allowedFindings": [
    {
      "ruleId": "private-legacy-endpoint",
      "pathPattern": "(?i)^docs/(?:production-acceptance-evidence|production-readiness-checklist|release-notes-[^/]+)\\.md$",
      "reason": "Historical verification records are retained until remediation is complete."
    },
    {
      "ruleId": "private-harbor-endpoint",
      "pathPattern": "(?i)^docs/(?:agent-1\\.0-install|current-dev-inventory|flynas-compose-checklist|local-dev-runbook|production-acceptance-evidence|production-readiness-checklist|pulse-roadmap|release-deployment-runbook|release-notes-[^/]+)\\.md$",
      "reason": "Historical and private deployment documentation is retained during remediation."
    }
  ]
}
