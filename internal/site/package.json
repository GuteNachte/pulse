{
	"name": "pulse",
	"private": true,
	"version": "1.0.6",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "lingui extract --overwrite --clean && lingui compile && vite build",
		"build:capacitor": "lingui extract --overwrite --clean && lingui compile && vite build --mode capacitor",
		"android:sync": "npm run build:capacitor && cap sync android && npm run build",
		"android:open": "cap open android",
		"preview": "vite preview",
		"sync": "lingui extract --overwrite --clean && lingui compile",
		"sync_no_compile": "lingui extract --overwrite --clean",
		"sync_and_purge": "lingui extract --overwrite --clean && lingui compile",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"test:asset-center": "node --experimental-strip-types src/modules/asset-center/asset-ai-task-query.test.ts && node --experimental-strip-types src/modules/asset-center/asset-ai-task-summary.test.ts && node --experimental-strip-types src/modules/asset-center/asset-enrichment-suggestion-query.test.ts && node --experimental-strip-types src/modules/asset-center/asset-parameter-display.test.ts && node --experimental-strip-types src/modules/asset-center/asset-runtime-hardware.test.ts && node --experimental-strip-types src/modules/asset-center/asset-visual-color.test.ts && node --experimental-strip-types src/modules/asset-center/asset-visual-query.test.ts",
		"check:versions": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../supplemental/scripts/check-version-consistency.ps1"
	},
	"dependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/core": "^8.4.1",
		"@capacitor/local-notifications": "^8.2.0",
		"@capacitor/preferences": "^8.0.1",
		"@lingui/react": "^6.4.0",
		"@nanostores/react": "^1.1.0",
		"@nanostores/router": "^1.0.0",
		"@radix-ui/react-alert-dialog": "^1.1.17",
		"@radix-ui/react-checkbox": "^1.3.5",
		"@radix-ui/react-dialog": "^1.1.17",
		"@radix-ui/react-direction": "^1.1.2",
		"@radix-ui/react-dropdown-menu": "^2.1.18",
		"@radix-ui/react-label": "^2.1.10",
		"@radix-ui/react-select": "^2.3.1",
		"@radix-ui/react-separator": "^1.1.10",
		"@radix-ui/react-slider": "^1.4.1",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-switch": "^1.3.1",
		"@radix-ui/react-tabs": "^1.1.15",
		"@radix-ui/react-toast": "^1.2.17",
		"@radix-ui/react-tooltip": "^1.2.10",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.3",
		"@xyflow/react": "^12.11.1",
		"capacitor-secure-storage-plugin": "^0.13.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"d3-time": "^3.1.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.21.0",
		"nanostores": "^1.3.0",
		"pocketbase": "^0.27.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"recharts": "^3.9.0",
		"shiki": "^4.3.0",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@biomejs/biome": "2.5.1",
		"@capacitor/cli": "^8.4.1",
		"@lingui/babel-plugin-lingui-macro": "^6.4.0",
		"@lingui/cli": "^6.4.0",
		"@lingui/vite-plugin": "^6.4.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"playwright": "^1.61.1",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.0"
	}
}
